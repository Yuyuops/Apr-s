{
  "version": "2026-09-29",
  "purpose": "Neutral hypothesis and scenario registry for Après. It records which modelling questions must be answered before a policy effect can be quantified.",
  "evidence_classes": {
    "calculable": "Direct accounting or rule-based effect when inputs are explicit.",
    "modelisable": "Requires a validated empirical, microsimulation, macroeconomic or sector model.",
    "scenario_only": "Requires explicit scenario branches because the outcome depends on institutions, negotiations or external responses.",
    "unsupported": "No validated model or sufficient implementation detail is available."
  },
  "horizon_method": [
    {
      "months": 1,
      "label": "1 mois",
      "focus": [
        "effets comptables directs",
        "calendrier juridique et administratif",
        "mesures immédiatement applicables"
      ],
      "uncertainty": "low_for_direct_effects"
    },
    {
      "months": 6,
      "label": "6 mois",
      "focus": [
        "mise en œuvre initiale",
        "premiers effets comportementaux seulement si un modèle existe",
        "délais opérationnels"
      ],
      "uncertainty": "medium"
    },
    {
      "months": 12,
      "label": "1 an",
      "focus": [
        "effets budgétaires annuels",
        "microsimulation fiscale-sociale",
        "premiers effets macro si modèle validé"
      ],
      "uncertainty": "medium"
    },
    {
      "months": 24,
      "label": "2 ans",
      "focus": [
        "interactions entre mesures",
        "capacités des services publics",
        "effets sectoriels et macro"
      ],
      "uncertainty": "high"
    },
    {
      "months": 60,
      "label": "5 ans",
      "focus": [
        "effets structurels",
        "boucles de rétroaction",
        "scénarios bas/central/haut"
      ],
      "uncertainty": "very_high"
    }
  ],
  "exogenous_variables": [

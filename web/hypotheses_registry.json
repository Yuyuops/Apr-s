  "interactions": [
    {
      "id": "tax_spending_mix",
      "label": "Fiscalité + dépenses",
      "requires_any": [
        [
          "taxation",
          "public_spending"
        ]
      ],
      "why": "Le solde budgétaire et les effets macro dépendent du paquet complet, pas de la somme de mesures isolées."
    },
    {
      "id": "minimum_wage_payroll_taxes",
      "label": "SMIC + cotisations",
      "requires_any": [
        [
          "minimum_wage",
          "taxation"
        ]
      ],
      "why": "Le coût du travail dépend simultanément du salaire brut et des prélèvements employeur/salarié."
    },
    {
      "id": "eu_euro_combo",
      "label": "UE + euro",
      "requires_any": [
        [
          "eu_exit",
          "euro_exit"
        ]
      ],
      "why": "Une sortie de l'UE et un changement de régime monétaire sont deux décisions distinctes dont les scénarios interagissent."
    },
    {
      "id": "administrative_transfer",
      "label": "Réorganisation + transfert de compétences",
